# GuardLayer middleware settings
OPENROUTER_APIKEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet
# Optional: site URL OpenRouter shows on dashboard (defaults to https://localhost)
# OPENROUTER_HTTP_REFERER=

# Nokia / CAMARA network-as-code API key
NOKIA_API_KEY=your_nokia_network_as_code_api_key_here
MOCK_MODE=false
PORT=3000
DASHBOARD_PORT=3001

# Live middleware SSE (browser POSTs to same origin; Vite proxies /api).
# Copy to .env.local and restart: npm run dev --workspace=@guard-layer/dashboard
VITE_USE_LIVE_SSE=true

# Optional: middleware base URL for the dev proxy (default http://localhost:3000).
# MIDDLEWARE_PROXY_URL=http://127.0.0.1:3000

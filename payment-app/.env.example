# Base URL of the GuardLayer middleware (no trailing slash). Use your machine LAN IP
# from the phone (not "localhost"), e.g. http://192.168.1.42:3000
# Leave unset to use the built-in mock pipeline in the app.
EXPO_PUBLIC_GUARD_LAYER_URL=

# Scenario string sent to POST /api/transaction/check (matches middleware README), e.g.
# all_clear | recent_sim_swap | location_anomaly | full_attack
EXPO_PUBLIC_GUARD_SCENARIO=all_clear

# Optional: exchangerate-api.com key for USD→local in the UI.
EXPO_PUBLIC_EXCHANGE_RATE_API=

# Preferred: OpenRouter (see https://openrouter.ai/) — e.g. anthropic/claude-sonnet-4.6
OPENROUTER_APIKEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional: site URL OpenRouter shows on dashboard (defaults to https://localhost)
# OPENROUTER_HTTP_REFERER=

# Fallback if OpenRouter is unset: direct Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTROPIC_MODEL=claude-sonnet-4-6

NOKIA_API_KEY=your_nokia_network_as_code_api_key_here
# Optional: dev | staging (RapidAPI host). Omit for production gateway.
# NOKIA_ENV_MODE=
MOCK_MODE=true
PORT=3000
DASHBOARD_PORT=3001
